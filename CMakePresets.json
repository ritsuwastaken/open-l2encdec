{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "shared",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "unix",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS universal",
            "inherits": "unix",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "WITH_OPTIM": "OFF"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "msvc-x64",
            "inherits": "msvc",
            "architecture": "x64"
        },
        {
            "name": "msvc-x86",
            "inherits": "msvc",
            "architecture": "Win32"
        },
        {
            "name": "msvc-arm64",
            "inherits": "msvc",
            "architecture": "ARM64"
        }
    ],
    "buildPresets": [
        {
            "name": "base",
            "hidden": true,
            "configuration": "Release"
        },
        {
            "name": "shared",
            "configurePreset": "shared",
            "configuration": "Debug"
        },
        {
            "name": "unix",
            "inherits": "base",
            "configurePreset": "unix"
        },
        {
            "name": "macos",
            "inherits": "base",
            "configurePreset": "macos"
        },
        {
            "name": "msvc-x64",
            "inherits": "base",
            "configurePreset": "msvc-x64"
        },
        {
            "name": "msvc-x86",
            "inherits": "base",
            "configurePreset": "msvc-x86"
        },
        {
            "name": "msvc-arm64",
            "inherits": "base",
            "configurePreset": "msvc-arm64"
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "shared",
            "inherits": "base",
            "configurePreset": "shared",
            "configuration": "Debug"
        },
        {
            "name": "unix",
            "inherits": "base",
            "configurePreset": "unix"
        },
        {
            "name": "macos",
            "inherits": "base",
            "configurePreset": "macos"
        },
        {
            "name": "msvc-x64",
            "inherits": "base",
            "configurePreset": "msvc-x64"
        },
        {
            "name": "msvc-x86",
            "inherits": "base",
            "configurePreset": "msvc-x86"
        }
    ],
    "packagePresets": [
        {
            "name": "base",
            "hidden": true,
            "generators": [
                "ZIP"
            ],
            "configurations": [
                "Release"
            ]
        },
        {
            "name": "unix",
            "inherits": "base",
            "configurePreset": "unix"
        },
        {
            "name": "macos",
            "inherits": "base",
            "configurePreset": "macos"
        },
        {
            "name": "msvc-x64",
            "inherits": "base",
            "configurePreset": "msvc-x64"
        },
        {
            "name": "msvc-x86",
            "inherits": "base",
            "configurePreset": "msvc-x86"
        }
    ]
}