{
    "version": 8,
    "configurePresets": [
        {
            "name": "unix",
            "displayName": "Unix preset",
            "description": "Sets Unix Makefiles generator and build directory",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build_unix/",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "L2ENCDEC_BUILD_TESTS": "ON",
                "L2ENCDEC_BUILD_CLI": "ON"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "binaryDir": "${sourceDir}/build_msvc/",
            "toolchainFile": "${sourceDir}/cmake/msvc-static-mt.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "OFF",
                "L2ENCDEC_BUILD_TESTS": "ON",
                "L2ENCDEC_BUILD_CLI": "ON"
            }
        },
        {
            "name": "msvc-x64",
            "inherits": "msvc-base",
            "displayName": "MSVC x64",
            "architecture": "x64"
        },
        {
            "name": "msvc-x86",
            "inherits": "msvc-base",
            "displayName": "MSVC x86",
            "architecture": "Win32"
        },
        {
            "name": "msvc-arm64",
            "inherits": "msvc-base",
            "displayName": "MSVC ARM64",
            "architecture": "ARM64"
        }
    ],
    "buildPresets": [
        {
            "name": "unix-build",
            "description": "Build using Unix Makefiles generator",
            "displayName": "Unix Build",
            "configurePreset": "unix"
        },
        {
            "name": "msvc-x64-build",
            "configurePreset": "msvc-x64",
            "configuration": "Release"
        },
        {
            "name": "msvc-x86-build",
            "configurePreset": "msvc-x86",
            "configuration": "Release"
        },
        {
            "name": "msvc-arm64-build",
            "configurePreset": "msvc-arm64",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "unix-test",
            "configurePreset": "unix"
        },
        {
            "name": "msvc-x86-test",
            "configurePreset": "msvc-x86",
            "configuration": "Release"
        }
    ]
}